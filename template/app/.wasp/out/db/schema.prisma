
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


generator client {
  provider = "prisma-client-js"
}


model User {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  email String? @unique
  username String? @unique
  isAdmin Boolean @default(false)
  paymentProcessorUserId String? @unique
  lemonSqueezyCustomerPortalUrl String?
  subscriptionStatus String?
  subscriptionPlan String?
  datePaid DateTime?
  credits Int @default(3)
  gptResponses GptResponse[]
  contactFormMessages ContactFormMessage[]
  tasks Task[]
  files File[]
  companyMemberships CompanyMembership[]
  auth Auth?
}


model ProcessedWebhookEvent {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  paymentProcessorEventId String @unique
  eventType String
}


model Company {
  companyNumber String @id
  name String
  registrationStatus String
  sicCodes String[] @default([])
  address Json?
  incorporationDate DateTime?
  trialEndsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships CompanyMembership[]
  complianceEvents ComplianceEvent[]
  riskAssessments RiskAssessment[]
  integrationSyncs CompanyIntegrationSync[]
  subscriptions CompanySubscription[]
}


model CompanyMembership {
  id String @id @default(uuid())
  userId String
  companyNumber String
  role CompanyRole @default(MEMBER)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyNumber], references: [companyNumber], onDelete: Cascade)
  @@unique([userId, companyNumber])
  @@index([companyNumber])
}


model ComplianceEvent {
  id String @id @default(uuid())
  provider ComplianceProvider
  externalId String
  companyNumber String?
  title String
  sourceUrl String?
  publishedAt DateTime?
  fetchedAt DateTime @default(now())
  payload Json?
  analysisText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company? @relation(fields: [companyNumber], references: [companyNumber], onDelete: SetNull)
  riskAssessments RiskAssessment[]
  @@unique([provider, externalId])
  @@index([companyNumber, publishedAt])
}


model RiskAssessment {
  id String @id @default(uuid())
  companyNumber String
  complianceEventId String
  severity RiskSeverity
  summary String
  rationale String
  recommendedActions String[] @default([])
  modelVersion String
  analyzedAt DateTime @default(now())
  notifiedAt DateTime?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyNumber], references: [companyNumber], onDelete: Cascade)
  complianceEvent ComplianceEvent @relation(fields: [complianceEventId], references: [id], onDelete: Cascade)
  @@index([companyNumber, analyzedAt])
  @@index([complianceEventId])
}


model CompanyIntegrationSync {
  id String @id @default(uuid())
  companyNumber String
  provider ComplianceProvider
  lastAttemptedAt DateTime?
  lastSuccessfulSyncAt DateTime?
  sourceCursor String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyNumber], references: [companyNumber], onDelete: Cascade)
  @@unique([companyNumber, provider])
}


model CompanySubscription {
  id String @id @default(uuid())
  companyNumber String
  dodoSubscriptionId String @unique
  plan String
  status String
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyNumber], references: [companyNumber], onDelete: Cascade)
  @@index([companyNumber, status])
}


model GptResponse {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  userId String
  content String
}


model Task {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId String
  description String
  time String @default("1")
  isDone Boolean @default(false)
}


model File {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId String
  name String
  type String
  s3Key String
}


model DailyStats {
  id Int @id @default(autoincrement())
  date DateTime @unique @default(now())
  totalViews Int @default(0)
  prevDayViewsChangePercent String @default("0")
  userCount Int @default(0)
  paidUserCount Int @default(0)
  userDelta Int @default(0)
  paidUserDelta Int @default(0)
  totalRevenue Float @default(0)
  totalProfit Float @default(0)
  sources PageViewSource[]
}


model PageViewSource {
  name String
  date DateTime @default(now())
  dailyStats DailyStats? @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId Int?
  visitors Int
  @@id([date, name])
}


model Logs {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now())
  message String
  level String
}


model ContactFormMessage {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId String
  content String
  isRead Boolean @default(false)
  repliedAt DateTime?
}


model Auth {
  id String @id @default(uuid())
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  identities AuthIdentity[]
  sessions Session[]
}


model AuthIdentity {
  providerName String
  providerUserId String
  providerData String @default("{}")
  authId String
  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)
  @@id([providerName, providerUserId])
}


model Session {
  id String @id @unique
  expiresAt DateTime
  userId String
  auth Auth @relation(references: [id], fields: [userId], onDelete: Cascade)
  @@index([userId])
}


enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}


enum ComplianceProvider {
  COMPANIES_HOUSE
  THE_GAZETTE
}


enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}


